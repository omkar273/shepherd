--- a/billing/service.py
+++ b/billing/service.py
@@ -1,13 +1,19 @@
-from billing.errors import InvalidRequest, InvalidState, NotFound
+import logging
+
+from billing.errors import InvalidRequest, InvalidState, NotFound, RefundTooLarge
 from billing.models import Context, Invoice, Status
+from billing.refund_policy import DefaultRefundPolicy, RefundPolicy
 from billing.repo import InvoiceRepo
 
+log = logging.getLogger(__name__)
+
 MAX_REASON = 500
 
 
 class InvoiceService:
-    def __init__(self, repo: InvoiceRepo):
+    def __init__(self, repo: InvoiceRepo, policy: RefundPolicy | None = None):
         self.repo = repo
+        self.policy = policy or DefaultRefundPolicy()
 
     def get(self, ctx: Context, invoice_id: str) -> Invoice:
         invoice = self.repo.get(invoice_id)
@@ -38,3 +44,33 @@ class InvoiceService:
             invoice.void_reason = reason.strip()
             self.repo.save(invoice)
             return invoice
+
+    def _get_invoice(self, invoice_id: str) -> Invoice:
+        return self.repo.get(invoice_id)
+
+    def refund(self, ctx: Context, invoice_id: str, amount_cents: int, request_id: str,
+               notify: bool = False) -> Invoice:
+        if not isinstance(amount_cents, int) or amount_cents <= 0:
+            raise InvalidRequest("amount must be a positive integer")
+        try:
+            with self.repo.lock(invoice_id):
+                invoice = self._get_invoice(invoice_id)
+                if invoice is None:
+                    raise NotFound(invoice_id)
+                if invoice.tenant_id != ctx.tenant_id:
+                    raise NotFound(invoice_id)
+                if request_id in invoice.refund_ids:
+                    return invoice
+                if invoice.status != Status.PAID:
+                    raise InvalidState(f"cannot refund a {invoice.status.value} invoice")
+                if amount_cents > self.policy.max_refund(invoice):
+                    raise RefundTooLarge(f"refund exceeds the {self.policy.max_refund(invoice)} cents left")
+                # refund the invoice
+                invoice.refunded_cents += amount_cents
+                invoice.refund_ids.append(request_id)
+                self.repo.save(invoice)
+                if notify:
+                    log.info("would notify customer %s about refund", invoice.customer_id)
+                return invoice
+        except Exception:
+            raise
