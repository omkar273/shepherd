diff --git a/billing/http.py b/billing/http.py
index 088251d..b38d090 100644
--- a/billing/http.py
+++ b/billing/http.py
@@ -21,12 +21,23 @@ def parse_void(body: dict) -> str:
     return reason
 
 
+def parse_refund(body: dict) -> tuple[int, str]:
+    amount = body.get("amount_cents")
+    request_id = body.get("request_id")
+    if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+        raise InvalidRequest("amount_cents must be a positive integer")
+    if not isinstance(request_id, str) or not request_id:
+        raise InvalidRequest("request_id is required")
+    return amount, request_id
+
+
 def render(invoice) -> dict:
     return {
         "id": invoice.id,
         "status": invoice.status.value,
         "total": fmt_cents(invoice.total_cents),
         "paid": fmt_cents(invoice.paid_cents),
+        "refunded": fmt_cents(invoice.refunded_cents),
     }
 
 
@@ -44,6 +55,12 @@ def handle_void(service: InvoiceService, ctx: Context, invoice_id: str, body: di
     return {**render(service.void(ctx, invoice_id, reason)), "previous": previous}
 
 
+def handle_refund(service: InvoiceService, ctx: Context, invoice_id: str, body: dict) -> dict:
+    amount, request_id = parse_refund(body)
+    service.get(ctx, invoice_id)
+    return render(service.refund(ctx, invoice_id, amount, request_id))
+
+
 ROUTES = {
     ("GET", "invoice"): handle_get,
     ("POST", "invoice/pay"): handle_pay,
