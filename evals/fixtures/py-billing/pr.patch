diff --git a/billing/refund_policy.py b/billing/refund_policy.py
new file mode 100644
index 0000000..1ee1394
--- /dev/null
+++ b/billing/refund_policy.py
@@ -0,0 +1,14 @@
+from abc import ABC, abstractmethod
+
+from billing.models import Invoice
+
+
+class RefundPolicy(ABC):
+    @abstractmethod
+    def max_refund(self, invoice: Invoice) -> int:
+        ...
+
+
+class DefaultRefundPolicy(RefundPolicy):
+    def max_refund(self, invoice: Invoice) -> int:
+        return invoice.paid_cents - invoice.refunded_cents
