diff --git a/internal/service/void.go b/internal/service/void.go
new file mode 100644
index 0000000..a8b3297
--- /dev/null
+++ b/internal/service/void.go
@@ -0,0 +1,127 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"log"
+	"strings"
+	"time"
+
+	"example.com/billing/internal/domain"
+	"example.com/billing/internal/types"
+)
+
+var ErrAlreadyVoided = errors.New("invoice already voided")
+
+type VoidRequest struct {
+	InvoiceID string `json:"-"`
+	Reason    string `json:"reason"`
+}
+
+func (r VoidRequest) Validate() error {
+	if r.InvoiceID == "" {
+		return errors.New("invoice_id is required")
+	}
+	if strings.TrimSpace(r.Reason) == "" {
+		return errors.New("reason is required")
+	}
+	if len(r.Reason) > 500 {
+		return errors.New("reason must be at most 500 characters")
+	}
+	return nil
+}
+
+type VoidResult struct {
+	Invoice     *domain.Invoice
+	RefundCents int64
+}
+
+type VoidOptions struct {
+	NotifyCustomer bool
+}
+
+type VoidReasonFormatter interface {
+	Format(reason string) string
+}
+
+type defaultVoidReasonFormatter struct{}
+
+func (defaultVoidReasonFormatter) Format(reason string) string {
+	return strings.TrimSpace(reason)
+}
+
+type VoidService interface {
+	Void(ctx context.Context, req VoidRequest) (*VoidResult, error)
+}
+
+type voidService struct {
+	repo      domain.InvoiceRepository
+	tx        domain.TxManager
+	formatter VoidReasonFormatter
+	opts      VoidOptions
+}
+
+func NewVoidService(repo domain.InvoiceRepository, tx domain.TxManager, opts VoidOptions) VoidService {
+	return &voidService{repo: repo, tx: tx, formatter: defaultVoidReasonFormatter{}, opts: opts}
+}
+
+func (s *voidService) getInvoice(ctx context.Context, id string) (*domain.Invoice, error) {
+	return s.repo.Get(ctx, id)
+}
+
+func (s *voidService) Void(ctx context.Context, req VoidRequest) (*VoidResult, error) {
+	if s.repo == nil {
+		return nil, errors.New("void service: repo not configured")
+	}
+	if err := req.Validate(); err != nil {
+		return nil, err
+	}
+
+	t, err := s.tx.Begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer t.Rollback()
+
+	inv, err := s.getInvoice(ctx, req.InvoiceID)
+	if err != nil {
+		return nil, err
+	}
+	if inv == nil {
+		return nil, domain.ErrNotFound
+	}
+	if inv.TenantID != types.TenantID(ctx) || inv.EnvironmentID != types.EnvironmentID(ctx) {
+		return nil, domain.ErrNotFound
+	}
+	if inv.Status == domain.StatusVoid {
+		return nil, ErrAlreadyVoided
+	}
+	if inv.Status != domain.StatusFinalized {
+		return nil, ErrInvalidState
+	}
+
+	var refund int64
+	if len(inv.Lines) > 0 {
+		for _, l := range inv.Lines {
+			refund += l.AmountCents
+		}
+	}
+
+	// void the invoice
+	now := time.Now()
+	inv.Status = domain.StatusVoid
+	inv.VoidedAt = &now
+	inv.VoidReason = s.formatter.Format(req.Reason)
+
+	if err := s.repo.Update(ctx, inv); err != nil {
+		log.Printf("void: update failed for %s: %v", inv.ID, err)
+		return nil, err
+	}
+	if s.opts.NotifyCustomer {
+		log.Printf("void: would notify customer %s", inv.CustomerID)
+	}
+	if err := t.Commit(); err != nil {
+		return nil, err
+	}
+	return &VoidResult{Invoice: inv, RefundCents: refund}, nil
+}
