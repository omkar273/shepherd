index 0000000..ea51c94
--- /dev/null
+++ b/internal/api/void_handler.go
@@ -0,0 +1,35 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"example.com/billing/internal/service"
+)
+
+type VoidHandler struct {
+	voids service.VoidService
+}
+
+func NewVoidHandler(voids service.VoidService) *VoidHandler {
+	return &VoidHandler{voids: voids}
+}
+
+func (h *VoidHandler) Void(w http.ResponseWriter, r *http.Request) {
+	var req service.VoidRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	req.InvoiceID = r.PathValue("id")
+	if err := req.Validate(); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	res, err := h.voids.Void(r.Context(), req)
+	if err != nil {
+		writeError(w, err)
+		return
+	}
+	json.NewEncoder(w).Encode(res)
+}
