--- /dev/null
+++ b/widgets/CreditBadge.tsx
@@ -0,0 +1,20 @@
+import { useEffect, useMemo, useState } from "react";
+
+interface CreditBadgeProps {
+  amountCents: number;
+}
+
+export function CreditBadge({ amountCents }: CreditBadgeProps) {
+  const [amount] = useState(amountCents);
+  const [label, setLabel] = useState("");
+  const hasCredit = useMemo(() => amount > 0, [amount]);
+
+  useEffect(() => {
+    setLabel(`$${(amount / 100).toFixed(2)} credit`);
+  }, [amount]);
+
+  if (!hasCredit) {
+    return null;
+  }
+  return <span className="badge">{label}</span>;
+}
