+++ b/src/rpc/procedures/apply-credit.ts
@@ -0,0 +1,22 @@
+import { z } from "zod";
+import type { CreditService } from "../../billing/credit";
+import type { RpcContext } from "../context";
+
+const applyCreditInput = z.object({
+  invoiceId: z.string().uuid(),
+  amountCents: z.number().int().positive(),
+});
+
+export function applyCreditProcedure({ credits }: { credits: CreditService }) {
+  return {
+    input: applyCreditInput,
+    async handler(ctx: RpcContext, input: z.infer<typeof applyCreditInput>) {
+      return credits.applyCredit({
+        tenantId: ctx.tenantId,
+        customerId: ctx.customerId,
+        invoiceId: input.invoiceId,
+        amountCents: input.amountCents,
+      });
+    },
+  };
+}
