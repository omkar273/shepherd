+++ b/src/billing/credit.ts
@@ -0,0 +1,77 @@
+import { BillingError } from "./errors";
+import type { CustomerStore, Invoice, InvoiceStore } from "./store";
+
+export interface ApplyCreditInput {
+  tenantId: string;
+  customerId: string;
+  invoiceId: string;
+  amountCents: number;
+}
+
+export interface CreditService {
+  applyCredit(input: ApplyCreditInput): Promise<Invoice>;
+}
+
+function notFound(id: string) {
+  return new BillingError("NOT_FOUND", `invoice ${id} not found`);
+}
+
+const isPositive = (n: number) => n > 0;
+
+export function createCreditService({
+  invoices,
+  customers,
+}: {
+  invoices: InvoiceStore;
+  customers: CustomerStore;
+}): CreditService {
+  const getInvoice = async (tenantId: string, id: string) =>
+    await invoices.get(tenantId, id);
+
+  return {
+    async applyCredit(input) {
+      if (typeof input.amountCents !== "number" || !isPositive(input.amountCents)) {
+        throw new Error("amountCents must be a positive number");
+      }
+
+      const invoice = await getInvoice(input.tenantId, input.invoiceId);
+      if (!invoice) {
+        throw notFound(input.invoiceId);
+      }
+      if (invoice.customerId !== input.customerId) {
+        throw notFound(input.invoiceId);
+      }
+      if (invoice.status === "paid") {
+        throw new BillingError("ALREADY_PAID", `invoice ${invoice.id} is paid`);
+      }
+
+      const customer = await customers.get(input.tenantId, input.customerId);
+      const balance = customer?.creditBalanceCents ?? 0;
+      if (input.amountCents > balance) {
+        throw new BillingError("NO_CREDIT", "not enough credit");
+      }
+
+      const remaining = invoice?.totalCents - invoice.creditAppliedCents;
+      if (input.amountCents > remaining) {
+        throw new BillingError("CREDIT_EXCEEDS_TOTAL", "credit exceeds amount due");
+      }
+
+      // apply the credit
+      const updated: Invoice = {
+        ...invoice,
+        creditAppliedCents: invoice.creditAppliedCents + input.amountCents,
+      };
+      try {
+        await invoices.save(updated);
+        await customers.setCreditBalance(
+          input.tenantId,
+          input.customerId,
+          balance - input.amountCents,
+        );
+      } catch (error) {
+        throw error;
+      }
+      return updated;
+    },
+  };
+}
