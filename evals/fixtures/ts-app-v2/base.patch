 src/billing/AGENTS.md  | 7 +++++++
 src/billing/ERRORS.md  | 5 +++++
 src/billing/service.ts | 6 ++++++
 src/billing/store.ts   | 2 +-
 src/rpc/audit.ts       | 3 +++
